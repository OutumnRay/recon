# =============================================================================
# Recontext — production .env для выделенного сервера (docker-compose.prod.yml)
# На сервере: scripts/server-setup.sh сам создаёт /opt/recontext/.env из этого файла
# и заменяет все __GENERATE__ на случайные секреты.
# Вручную: cp .env.prod.example .env  и замените __GENERATE__ на `openssl rand -hex 24`
# =============================================================================

# --- Домен ---
DOMAIN=24recontext.ru
PORTAL_URL=https://24recontext.ru

# --- Администратор (создаётся при первом запуске на пустой БД) ---
ADMIN_EMAIL=admin@24recontext.ru
ADMIN_PASSWORD=__GENERATE__

# --- PostgreSQL ---
DB_USER=recontext
DB_PASSWORD=__GENERATE__
DB_NAME=recontext

# --- RabbitMQ ---
RABBITMQ_USER=recontext
RABBITMQ_PASSWORD=__GENERATE__

# --- MinIO ---
MINIO_ACCESS_KEY=recontext
MINIO_SECRET_KEY=__GENERATE__
MINIO_BUCKET=recontext
# Публичный адрес для presigned URL (браузер ходит сюда напрямую через host-nginx)
MINIO_PUBLIC_ENDPOINT=https://storage.24recontext.ru
MINIO_USE_SSL=false

# --- Порталы (наружу через host-nginx) ---
MANAGING_PORTAL_PORT=20080
USER_PORTAL_PORT=20081

# Инфраструктурные порты (Postgres, Redis, RabbitMQ, Grafana, ...) слушают только этот адрес.
# 127.0.0.1 — доступ только с сервера / через SSH-туннель. 0.0.0.0 — из всей локальной сети.
INTERNAL_BIND_ADDR=127.0.0.1

# --- LiveKit (видеоконференции) ---
# Публичный адрес, который получает браузер
LIVEKIT_URL=wss://livekit.24recontext.ru
# Адрес для серверных вызовов из managing-portal (внутри docker-сети)
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_API_KEY=APIrecontext
# Секрет должен быть не короче 32 символов
LIVEKIT_API_SECRET=__GENERATE__
LIVEKIT_WEBHOOK_DEBUG=false
LIVEKIT_EGRESS_ENABLED=false
LIVEKIT_EGRESS_RECORD_TRACKS=false

# --- Транскрипция (Whisper) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=ru
HF_TOKEN=
ENABLE_DIARIZATION=false
QDRANT_ENABLED=false

# --- LLM (Ollama на этом же сервере) ---
LLM_API_ENDPOINT=http://ollama:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# --- SMTP (письма с приглашениями/сбросом пароля) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@24recontext.ru
SMTP_FROM_NAME=Recontext

# --- Firebase Cloud Messaging (push-уведомления, JSON в одну строку) ---
FCM_CREDENTIALS_JSON=

# --- Наблюдаемость ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE__
GRAFANA_ROOT_URL=https://grafana.24recontext.ru

# --- Прочее ---
APP_VERSION=0.1.0+0
DEBUG_LOGS_ENABLED=false
LOG_LEVEL=INFO
